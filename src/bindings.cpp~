#include <pybind11/pybind11.h>
#include <pybind11/stl.h>
#include "engine.hpp"

namespace py = pybind11;

// Standalone global engine instance for helper function
static SimulationEngine g_engine;
static bool g_initialized = false;

py::dict run_step_telemetry(int step_cnt, double inf_rate, double def_power) {
    if (!g_initialized) {
        g_engine.initialize_network(5);
        g_initialized = true;
    }
    
    g_engine.step(inf_rate, def_power);
    
    py::dict res;
    res["step"] = g_engine.get_step_count();
    res["status"] = "Simulating (C++ Engine)";
    res["infected_nodes"] = g_engine.get_infected_count();
    res["total_nodes"] = g_engine.get_total_nodes();
    res["active_defenses"] = static_cast<int>(def_power * 5);
    res["threat_level_pct"] = g_engine.get_network_threat_pct();
    return res;
}

PYBIND11_MODULE(sim_engine, m) {
    m.doc() = "C++ Tactical Outbreak Simulation Engine";

    m.def("run_step_telemetry", &run_step_telemetry, "Run simulation step and return telemetry dictionary");

    py::class_<SimulationEngine>(m, "SimulationEngine")
        .def(py::init<>())
        .def("initialize_network", &SimulationEngine::initialize_network)
        .def("step", &SimulationEngine::step)
        .def("isolate_node", &SimulationEngine::isolate_node)
        .def("get_step_count", &SimulationEngine::get_step_count)
        .def("get_infected_count", &SimulationEngine::get_infected_count)
        .def("get_total_nodes", &SimulationEngine::get_total_nodes)
        .def("get_network_threat_pct", &SimulationEngine::get_network_threat_pct);
}
